# Public address of this app, without trailing slash (used for links in emails and metadata)
NEXT_PUBLIC_SITE_URL=https://remembered.padrewassonfoundation.org

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Server only. Never expose this key in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to sign form tokens and to salt rate-limit keys.
# Generate one with: openssl rand -base64 32
SUBMISSION_SECRET=

# Where the "give in their memory" link points. Defaults to the foundation's Donate page.
# DONATE_URL=https://padrewassonfoundation.org/donate

# Let search engines index memorial pages. Off by default; the foundation decides.
# ALLOW_INDEXING=false

# Optional: Cloudflare Turnstile as extra spam protection. Off unless both are set.
# Note: this loads a script from Cloudflare (a third party) on the forms.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
